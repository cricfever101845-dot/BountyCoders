# Copy to .env for local development. Never commit your real .env file.
ENVIRONMENT=development
BOUNTY_SECRET_KEY=replace-with-a-random-local-secret
DATABASE_URL=PASTE_SUPABASE_SESSION_POOLER_CONNECTION_STRING
DB_SSLMODE=require
CODE_EXECUTION_ENABLED=true
CODE_EXECUTION_PROVIDER=onlinecompiler
CODE_EXECUTION_TIME_LIMIT=8
CODE_EXECUTION_REQUEST_TIMEOUT=40
CODE_EXECUTION_PER_HOUR=30
CODE_EXECUTION_PER_DAY=100
CODE_EXECUTION_PER_MONTH=80000
ONLINECOMPILER_API_KEY=PASTE_YOUR_PRIVATE_PROVIDER_API_KEY
